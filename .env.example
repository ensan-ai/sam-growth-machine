# NOVA — local runtime configuration
# Copy this file to .env for local development. Never commit .env.

# Apify
APIFY_TOKEN=
APIFY_INSTAGRAM_REEL_ACTOR=apify/instagram-reel-scraper

# Notion runtime access
# Create a Notion integration (or future OAuth connection) and keep this secret local.
NOTION_TOKEN=

# NOVA Notion data sources (not secrets)
NOVA_CREATOR_MEMORY_DATA_SOURCE_ID=0151a8b8-b8fc-4301-a57d-df8206350a4b
NOVA_INSTAGRAM_SCRIPTS_DATA_SOURCE_ID=aed7fbe3-df36-451b-808a-2d859eb00188
NOVA_CV_PORTFOLIO_DATA_SOURCE_ID=8b8036ef-f92e-4f0d-bd5f-5c1969e7f376

# Optional development target
NOVA_TEST_INSTAGRAM_USERNAME=steventawfik
