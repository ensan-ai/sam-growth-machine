{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sam-growth-machine.local/agents/jax/schemas/input.schema.json",
  "title": "Jax Input Contract",
  "description": "Strict Phase 2E creative inputs. Adam's CONTENT_BRIEF and Brain's CONTENT_DRAFT are referenced canonically so Jax cannot loosen either completed interface.",
  "oneOf": [
    {"$ref": "https://sam-growth-machine.local/agents/adam/schemas/output.schema.json#/$defs/contentBrief"},
    {"$ref": "https://sam-growth-machine.local/agents/brain/schemas/output.schema.json#/$defs/contentDraft"},
    {"$ref": "#/$defs/sourceAssets"},
    {"$ref": "#/$defs/samDirection"}
  ],
  "$defs": {
    "extensions": {
      "type": "object",
      "description": "Namespaced future fields. Core contract fields remain closed.",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_-]*$"},
      "additionalProperties": true
    },
    "stringArray": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "nonEmptyStringArray": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "visualType": {
      "enum": [
        "A_ROLL",
        "SCREEN_RECORDING",
        "SCREENSHOT",
        "PRODUCT_UI",
        "DOCUMENT",
        "REAL_WORLD_EXAMPLE",
        "TEXT_OVERLAY",
        "DIAGRAM",
        "CHART",
        "GENERATED_IMAGE",
        "GENERATED_VIDEO",
        "B_ROLL",
        "MOTION_GRAPHIC",
        "THUMBNAIL",
        "OTHER"
      ]
    },
    "sourceAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "visual_type",
        "visual_type_extension",
        "classification",
        "locator",
        "description",
        "source_reference",
        "factual_role",
        "rights_or_usage_status",
        "usage_constraints",
        "approval_sensitive",
        "available"
      ],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1},
        "visual_type": {"$ref": "#/$defs/visualType"},
        "visual_type_extension": {"type": ["string", "null"]},
        "classification": {"enum": ["REAL", "GENERATED", "DESIGNED", "REFERENCE_ONLY"]},
        "locator": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "source_reference": {"type": "string", "minLength": 1},
        "factual_role": {"enum": ["EVIDENCE", "SUPPORTING", "DECORATION", "REFERENCE_ONLY"]},
        "rights_or_usage_status": {
          "type": "string",
          "minLength": 1,
          "description": "Declared status only; exact rights policy remains unresolved."
        },
        "usage_constraints": {"$ref": "#/$defs/stringArray"},
        "approval_sensitive": {"type": "boolean"},
        "available": {"type": "boolean"},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "allOf": [
        {
          "if": {"properties": {"visual_type": {"const": "OTHER"}}, "required": ["visual_type"]},
          "then": {"properties": {"visual_type_extension": {"type": "string", "minLength": 1}}},
          "else": {"properties": {"visual_type_extension": {"type": "null"}}}
        }
      ]
    },
    "sourceAssets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_type",
        "created_by",
        "source_input_references",
        "source_assets_id",
        "brief_id",
        "draft_id",
        "assets",
        "completeness_note"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "artifact_type": {"const": "SOURCE_ASSETS"},
        "created_by": {"enum": ["sam", "adam", "brain", "system"]},
        "source_input_references": {"$ref": "#/$defs/nonEmptyStringArray"},
        "source_assets_id": {"type": "string", "minLength": 1},
        "brief_id": {"type": "string", "minLength": 1},
        "draft_id": {"type": ["string", "null"]},
        "assets": {
          "type": "array",
          "items": {"$ref": "#/$defs/sourceAsset"},
          "minItems": 1
        },
        "completeness_note": {"type": "string", "minLength": 1},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "samDirection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_type",
        "created_by",
        "source_input_references",
        "direction_id",
        "brief_id",
        "draft_id",
        "direction_type",
        "requested_change",
        "reason",
        "constraints_must_remain_unchanged",
        "original_creative_package_reference",
        "target_platforms"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "artifact_type": {"const": "SAM_DIRECTION"},
        "created_by": {"const": "sam"},
        "source_input_references": {"$ref": "#/$defs/nonEmptyStringArray"},
        "direction_id": {"type": "string", "minLength": 1},
        "brief_id": {"type": "string", "minLength": 1},
        "draft_id": {"type": ["string", "null"]},
        "direction_type": {
          "enum": ["INITIAL_CREATIVE_CONSTRAINT", "TARGETED_REVISION", "VISUAL_PREFERENCE_FEEDBACK"]
        },
        "requested_change": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "constraints_must_remain_unchanged": {"$ref": "#/$defs/nonEmptyStringArray"},
        "original_creative_package_reference": {"type": ["string", "null"]},
        "target_platforms": {
          "type": "array",
          "items": {
            "enum": [
              "Instagram Reels",
              "TikTok",
              "YouTube Shorts",
              "Facebook Reels",
              "LinkedIn",
              "X",
              "Facebook Feed"
            ]
          },
          "uniqueItems": true
        },
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "allOf": [
        {
          "if": {"properties": {"direction_type": {"const": "TARGETED_REVISION"}}, "required": ["direction_type"]},
          "then": {"properties": {"original_creative_package_reference": {"type": "string", "minLength": 1}}}
        }
      ]
    }
  }
}
